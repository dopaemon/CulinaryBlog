# ---------- App ----------
NODE_ENV=development
# macOS: port 5000 bị AirPlay Receiver chiếm -> đổi thành 5050 nếu docker publish lỗi
BACKEND_PORT=5000
FRONTEND_PORT=3000
NGINX_PORT=80
NGINX_SSL_PORT=443
CORS_ORIGIN=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=culinary
POSTGRES_PASSWORD=culinary_dev_password
POSTGRES_DB=culinary_blog
DATABASE_URL=postgresql://culinary:culinary_dev_password@localhost:5432/culinary_blog

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ---------- SMTP / Welcome Email ----------
# Khi chạy backend trực tiếp trên máy host, dùng localhost.
# Docker Compose override MAIL_HOST thành mailpit.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@culinaryblog.local

# ---------- MinIO / S3 ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=culinary-blog
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---------- JWT ----------
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Google OAuth 2.0 ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---------- Frontend ----------
# Giá trị dưới đây dùng cho dev (`pnpm dev:fe`, backend chạy trực tiếp ở host, không qua Nginx).
# Chạy full stack qua docker-compose.prod.yml, backend đứng sau Nginx SSL termination -> 2 build arg
# này bị override thành https://localhost/api ngay trong docker-compose.prod.yml, không đọc giá trị ở đây.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Google Identity Services (GIS) chạy client-side cần chính client_id OAuth ở
# trên (GOOGLE_CLIENT_ID) nhưng lộ công khai qua prefix NEXT_PUBLIC_ -> build arg
# riêng, không cần khai báo giá trị mới.
# Base URL của frontend, backend dùng để sinh link trong welcome email.
AUTH_URL=http://localhost:3000

# ---------- Observability ----------
LOG_LEVEL=debug
SEQ_URL=
SEQ_API_KEY=
# Seq dev (chỉ bật khi chấp nhận điều khoản Seq)
SEQ_ACCEPT_EULA=N
OTEL_SERVICE_NAME=culinary-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
